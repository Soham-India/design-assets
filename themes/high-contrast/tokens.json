{
  "id": "high-contrast",
  "name": "High-Contrast",
  "description": "Accessibility-first with WCAG AAA-grade color pairs, pure black/white bases, strong borders and bold hues.",
  "tags": ["accessible", "aaa", "contrast", "bold", "functional"],
  "modes": ["light", "dark"],
  "files": {
    "css": "high-contrast/theme.css",
    "tokens": "high-contrast/tokens.json",
    "tailwind": "high-contrast/tailwind.css"
  },
  "swatch": ["#ffffff", "#0033cc", "#660099", "#b30000", "#000000"],
  "static": {
    "fonts": {
      "body": "Verdana, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "display": "Verdana, Geneva, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.1875, "md": 0.25, "lg": 0.375, "xl": 0.5, "full": 9999 }
  },
  "light": {
    "colors": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surfaceRaised": "#ffffff",
      "border": "#000000",
      "text": "#000000",
      "textMuted": "#333333",
      "ring": "#0033cc",
      "primary": "#0033cc",
      "primaryHover": "#002299",
      "primarySubtle": "#e5eaff",
      "secondary": "#660099",
      "secondaryHover": "#4d0073",
      "secondarySubtle": "#f3e5fa",
      "accent": "#b30000",
      "accentHover": "#8f0000",
      "accentSubtle": "#fae5e5",
      "success": "#006600",
      "successSubtle": "#e0f0e0",
      "warning": "#805500",
      "warningSubtle": "#f2e8d9",
      "error": "#cc0000",
      "errorSubtle": "#fadada",
      "info": "#0033cc",
      "infoSubtle": "#e5eaff"
    },
    "shadows": {
      "sm": "0 2px 0 rgba(0, 0, 0, 0.25)",
      "md": "0 3px 0 rgba(0, 0, 0, 0.30)",
      "lg": "0 5px 0 rgba(0, 0, 0, 0.35)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#000000",
      "surface": "#0d0d0d",
      "surfaceRaised": "#1a1a1a",
      "border": "#ffffff",
      "text": "#ffffff",
      "textMuted": "#cccccc",
      "ring": "#8ab4ff",
      "primary": "#8ab4ff",
      "primaryHover": "#a8c7ff",
      "primarySubtle": "#142033",
      "secondary": "#cc99ff",
      "secondaryHover": "#ddb3ff",
      "secondarySubtle": "#221433",
      "accent": "#ff9999",
      "accentHover": "#ffb3b3",
      "accentSubtle": "#331414",
      "success": "#33cc33",
      "successSubtle": "#0d2818",
      "warning": "#ffcc00",
      "warningSubtle": "#332900",
      "error": "#ff3333",
      "errorSubtle": "#331111",
      "info": "#8ab4ff",
      "infoSubtle": "#142033"
    },
    "shadows": {
      "sm": "0 2px 0 rgba(0, 0, 0, 0.90)",
      "md": "0 3px 0 rgba(0, 0, 0, 0.92)",
      "lg": "0 5px 0 rgba(0, 0, 0, 0.95)"
    }
  }
}
