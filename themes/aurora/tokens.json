{
  "id": "aurora",
  "name": "Aurora",
  "description": "Polar night teal and violet with ice-blue shimmer. Electric, crisp and luminous.",
  "tags": ["aurora", "teal", "night", "vibrant"],
  "modes": ["light", "dark"],
  "files": {
    "css": "aurora/theme.css",
    "tokens": "aurora/tokens.json",
    "tailwind": "aurora/tailwind.css"
  },
  "swatch": ["#0d1b1e", "#1c806e", "#7a5fb8", "#34799c", "#f2faf6"],
  "static": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Segoe UI\", -apple-system, BlinkMacSystemFont, Roboto, sans-serif",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.25, "md": 0.5, "lg": 0.75, "xl": 1.0, "full": 9999 }
  },
  "light": {
    "colors": {
      "bg": "#f2faf6",
      "surface": "#e7efeb",
      "surfaceRaised": "#f9fdfb",
      "border": "#d7dedb",
      "text": "#272827",
      "textMuted": "#707372",
      "ring": "#1c806e",
      "primary": "#1c806e",
      "primaryHover": "#197161",
      "primarySubtle": "#d0e6e0",
      "secondary": "#7a5fb8",
      "secondaryHover": "#6b54a2",
      "secondarySubtle": "#dfe1ec",
      "accent": "#34799c",
      "accentHover": "#2e6a89",
      "accentSubtle": "#d4e5e8",
      "success": "#38704c",
      "successSubtle": "#d5e6dc",
      "warning": "#7d6312",
      "warningSubtle": "#e4e6d2",
      "error": "#a8433d",
      "errorSubtle": "#e9deda",
      "info": "#3b6794",
      "infoSubtle": "#d5e4e8"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(39, 40, 39, 0.08)",
      "md": "0 4px 14px rgba(39, 40, 39, 0.10)",
      "lg": "0 14px 36px rgba(39, 40, 39, 0.16)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0d1b1e",
      "surface": "#192629",
      "surfaceRaised": "#2a3639",
      "border": "#3b4649",
      "text": "#eeefef",
      "textMuted": "#9ea4a5",
      "ring": "#6db6a9",
      "primary": "#6db6a9",
      "primaryHover": "#7fbfb3",
      "primarySubtle": "#203a3a",
      "secondary": "#a997d1",
      "secondaryHover": "#b3a3d7",
      "secondarySubtle": "#2c3442",
      "accent": "#81b6d1",
      "accentHover": "#90bfd7",
      "accentSubtle": "#243a42",
      "success": "#7fbf94",
      "successSubtle": "#263f38",
      "warning": "#d9b25e",
      "warningSubtle": "#3a3c2c",
      "error": "#e08080",
      "errorSubtle": "#3b3134",
      "info": "#80aad9",
      "infoSubtle": "#263a47"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.35)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.42)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.52)"
