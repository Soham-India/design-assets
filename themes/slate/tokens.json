{
  "id": "slate",
  "name": "Slate",
  "description": "Cool slate blues and grays with a copper spark. Quiet, precise and modern.",
  "tags": ["slate", "gray", "minimal", "cool"],
  "modes": ["light", "dark"],
  "files": {
    "css": "slate/theme.css",
    "tokens": "slate/tokens.json",
    "tailwind": "slate/tailwind.css"
  },
  "swatch": ["#16191d", "#4a6b8a", "#5f6b7a", "#94665b", "#f5f7f9"],
  "static": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Segoe UI\", -apple-system, BlinkMacSystemFont, Roboto, sans-serif",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.125, "md": 0.1875, "lg": 0.25, "xl": 0.375, "full": 9999 }
  },
  "light": {
    "colors": {
      "bg": "#f5f7f9",
      "surface": "#eaecee",
      "surfaceRaised": "#fafbfc",
      "border": "#dadcde",
      "text": "#272828",
      "textMuted": "#717172",
      "ring": "#4a6b8a",
      "primary": "#4a6b8a",
      "primaryHover": "#415e79",
      "primarySubtle": "#dae1e7",
      "secondary": "#5f6b7a",
      "secondaryHover": "#545e6b",
      "secondarySubtle": "#dde1e5",
      "accent": "#94665b",
      "accentHover": "#825a50",
      "accentSubtle": "#e5e0e0",
      "success": "#376f4b",
      "successSubtle": "#d8e3df",
      "warning": "#7b6212",
      "warningSubtle": "#e6e3d5",
      "error": "#a7423d",
      "errorSubtle": "#ecdbdc",
      "info": "#3a6693",
      "infoSubtle": "#d8e1eb"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(39, 40, 40, 0.08)",
      "md": "0 4px 14px rgba(39, 40, 40, 0.10)",
      "lg": "0 14px 36px rgba(39, 40, 40, 0.16)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#16191d",
      "surface": "#222428",
      "surfaceRaised": "#323538",
      "border": "#424548",
      "text": "#efefef",
      "textMuted": "#a2a3a5",
      "ring": "#899fb3",
      "primary": "#899fb3",
      "primaryHover": "#97abbc",
      "primarySubtle": "#2d343b",
      "secondary": "#979fa9",
      "secondaryHover": "#a3abb3",
      "secondarySubtle": "#303439",
      "accent": "#bd9f97",
      "accentHover": "#c5aba3",
      "accentSubtle": "#373435",
      "success": "#7fbf94",
      "successSubtle": "#2d3e37",
      "warning": "#d9b25e",
      "warningSubtle": "#413b2b",
      "error": "#e08282",
      "errorSubtle": "#423033",
      "info": "#80aad9",
      "infoSubtle": "#2d3946"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.35)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.42)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.52)"
    }
  }
}