{
  "id": "mono",
  "name": "Mono",
  "description": "Pure grayscale with sharp corners and monospace display type. Typography-forward minimalism that stays out of the way.",
  "tags": ["minimal", "grayscale", "monochrome", "sharp", "brutalist"],
  "modes": ["light", "dark"],
  "files": {
    "css": "mono/theme.css",
    "tokens": "mono/tokens.json",
    "tailwind": "mono/tailwind.css"
  },
  "swatch": {
    "bg": "#fafafa",
    "surface": "#141414",
    "primary": "#111111",
    "secondary": "#454545",
    "accent": "#171717"
  },
  "static": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.125, "md": 0.1875, "lg": 0.25, "xl": 0.375, "full": 9999 }
  },
  "light": {
    "colors": {
      "bg": "#fafafa",
      "surface": "#f4f4f4",
      "surfaceRaised": "#ffffff",
      "border": "#e3e3e3",
      "text": "#111111",
      "textMuted": "#6b6b6b",
      "ring": "#111111",
      "primary": "#111111",
      "primaryHover": "#2e2e2e",
      "primarySubtle": "#ececec",
      "secondary": "#454545",
      "secondaryHover": "#333333",
      "secondarySubtle": "#eeeeee",
      "accent": "#171717",
      "accentHover": "#000000",
      "accentSubtle": "#e9e9e9",
      "success": "#3c754f",
      "successSubtle": "#e2ece4",
      "warning": "#806527",
      "warningSubtle": "#f0e8d3",
      "error": "#ab4040",
      "errorSubtle": "#f3dede",
      "info": "#446c89",
      "infoSubtle": "#dee8ef"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(17, 17, 17, 0.06)",
      "md": "0 3px 10px rgba(17, 17, 17, 0.08)",
      "lg": "0 12px 32px rgba(17, 17, 17, 0.14)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0a0a0a",
      "surface": "#141414",
      "surfaceRaised": "#1f1f1f",
      "border": "#2b2b2b",
      "text": "#ededed",
      "textMuted": "#8f8f8f",
      "ring": "#ededed",
      "primary": "#ededed",
      "primaryHover": "#ffffff",
      "primarySubtle": "#232323",
      "secondary": "#b5b5b5",
      "secondaryHover": "#cfcfcf",
      "secondarySubtle": "#222222",
      "accent": "#ffffff",
      "accentHover": "#ededed",
      "accentSubtle": "#262626",
      "success": "#74b98b",
      "successSubtle": "#17251b",
      "warning": "#d4b36a",
      "warningSubtle": "#292315",
      "error": "#d97c7c",
      "errorSubtle": "#2b1717",
      "info": "#7ca3c2",
      "infoSubtle": "#152230"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.50)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.60)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.70)"
    }
  }
}
