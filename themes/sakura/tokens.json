{
  "id": "sakura",
  "name": "Sakura",
  "description": "Cherry-blossom pinks, plum and peach. Soft, romantic and fresh - spring at first bloom.",
  "tags": ["pastel", "pink", "spring", "soft"],
  "modes": ["light", "dark"],
  "files": {
    "css": "sakura/theme.css",
    "tokens": "sakura/tokens.json",
    "tailwind": "sakura/tailwind.css"
  },
  "swatch": ["#241a1f", "#b75077", "#8865a0", "#9e654d", "#fff7f9"],
  "static": {
