{
  "id": "terminal",
  "name": "Terminal",
  "description": "Phosphor-green on black with classic amber accents — retro CRT hacker aesthetic. Dark-only. Includes effects.css (scanlines, vignette, phosphor glow, flicker, CRT power-on, block cursor, term scrollbar).",
  "tags": ["green", "retro", "crt", "hacker", "terminal", "dark"],
  "modes": ["dark"],
  "files": {
    "css": "terminal/theme.css",
    "tokens": "terminal/tokens.json",
    "tailwind": "terminal/tailwind.css",
    "effects": "terminal/effects.css"
  },
  "swatch": ["#050805", "#00ff41", "#ffb000", "#7dffce", "#4a9e5c"],
  "static": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.125, "md": 0.1875, "lg": 0.25, "xl": 0.375, "full": 9999 }
  },
  "extras": {
    "shadowGlow": "0 0 20px rgba(0, 255, 65, 0.35)"
  },
  "dark": {
    "colors": {
      "bg": "#050805",
      "surface": "#0a120a",
      "surfaceRaised": "#142114",
      "border": "#1e3317",
      "text": "#00ff41",
      "textMuted": "#4a9e5c",
      "ring": "#00ff41",
      "primary": "#00ff41",
      "primaryHover": "#66ff8f",
      "primarySubtle": "#0a2912",
      "secondary": "#ffb000",
      "secondaryHover": "#ffc633",
      "secondarySubtle": "#2e2200",
      "accent": "#7dffce",
      "accentHover": "#a5ffdf",
      "accentSubtle": "#0a2920",
      "success": "#00ff41",
      "successSubtle": "#0a2912",
      "warning": "#ffb000",
      "warningSubtle": "#2e2200",
      "error": "#ff3b3b",
      "errorSubtle": "#330d0d",
      "info": "#33ccff",
      "infoSubtle": "#062330"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.60)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.65)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.75)",
      "glow": "0 0 20px rgba(0, 255, 65, 0.35)"
    }
  }
}
