{
  "id": "matcha",
  "name": "Matcha",
  "description": "Whisked green tea, rice-gold and red bean. Calm, natural and balanced.",
  "tags": ["green", "tea", "natural", "calm"],
  "modes": ["light", "dark"],
  "files": {
    "css": "matcha/theme.css",
    "tokens": "matcha/tokens.json",
    "tailwind": "matcha/tailwind.css"
  },
  "swatch": ["#1b2118", "#537d36", "#83712f", "#a75e52", "#f6f9f0"],
  "static": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "ui-rounded, \"Hiragino Maru Gothic ProN\", Quicksand, Comfortaa, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "spacingBase": 0.25,
    "radius": { "sm": 0.3125, "md": 0.5625, "lg": 0.8125, "xl": 1.125, "full": 9999 }
  },
  "light": {
    "colors": {
      "bg": "#f6f9f0",
      "surface": "#ebeee5",
      "surfaceRaised": "#fbfcf8",
      "border": "#dbded6",
      "text": "#272826",
      "textMuted": "#71736e",
      "ring": "#537d36",
      "primary": "#537d36",
      "primaryHover": "#496e30",
      "primarySubtle": "#dce5d2",
      "secondary": "#83712f",
      "secondaryHover": "#736329",
      "secondarySubtle": "#e4e3d1",
      "accent": "#a75e52",
      "accentHover": "#935348",
      "accentSubtle": "#e9e0d7",
      "success": "#37704b",
      "successSubtle": "#d9e5d7",
      "warning": "#7c6312",
      "warningSubtle": "#e7e5cd",
      "error": "#a8423d",
      "errorSubtle": "#edddd4",
      "info": "#3b6794",
      "infoSubtle": "#d9e3e3"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(39, 40, 38, 0.08)",
      "md": "0 4px 14px rgba(39, 40, 38, 0.10)",
      "lg": "0 14px 36px rgba(39, 40, 38, 0.16)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#1b2118",
      "surface": "#262c24",
      "surfaceRaised": "#363c34",
      "border": "#464b44",
      "text": "#efefef",
      "textMuted": "#a4a6a3",
      "ring": "#97b682",
      "primary": "#97b682",
      "primaryHover": "#a3bf91",
      "primarySubtle": "#343f2d",
      "secondary": "#c1b47f",
      "secondaryHover": "#c8bd8e",
      "secondarySubtle": "#3c3e2d",
      "accent": "#c6978f",
      "accentHover": "#cda39c",
      "accentSubtle": "#3d3930",
      "success": "#7fbf94",
      "successSubtle": "#314433",
      "warning": "#d9b25e",
      "warningSubtle": "#454127",
      "error": "#e28a8a",
      "errorSubtle": "#46362f",
      "info": "#80aad9",
      "infoSubtle": "#313f42"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.35)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.42)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.52)"
    }
  }
}