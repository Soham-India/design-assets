{
  "id": "cyberpunk",
  "name": "Cyberpunk",
  "description": "Dark-only blueprint/terminal aesthetic — abyss blacks, neon-blue glow and icy-blue accents with sharp panel cuts. Ported from the AI-interview-coach project.",
  "tags": ["dark", "neon", "blueprint", "terminal", "cyberpunk", "glow"],
  "modes": ["dark"],
  "files": {
    "css": "cyberpunk/theme.css",
    "tokens": "cyberpunk/tokens.json",
    "tailwind": "cyberpunk/tailwind.css",
    "effects": "cyberpunk/effects.css"
  },
  "swatch": ["#050b14", "#0088ff", "#a8c8ff", "#d5e0ff", "#8ba0b8"],
  "static": {
    "fonts": {
      "body": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "display": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "mono": "ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace"
    },
    "typeScale": {
      "xs": 0.75,
      "sm": 0.875,
      "base": 1.0,
      "lg": 1.125,
      "xl": 1.25,
      "2xl": 1.5,
      "3xl": 1.875,
      "4xl": 2.25
    },
    "displayTypeScale": {
      "hero-score": { "size": 120, "lineHeight": 110, "weight": 900, "letterSpacing": "-0.05em" },
      "headline-xl": { "size": 72, "lineHeight": 80, "weight": 800, "letterSpacing": "-0.03em" },
      "scene-focus": { "size": 48, "lineHeight": 56, "weight": 700 },
      "body-lg": { "size": 24, "lineHeight": 1.6, "weight": 400 },
      "metadata": { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": "0.15em" }
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 900 },
    "spacingBase": 0.25,
    "spacingSemantic": { "unit": 8, "gutter": 24, "panelPadding": 32, "marginEdge": 48 },
    "radius": { "sm": 0.25, "md": 0.375, "lg": 0.5, "xl": 0.75, "full": 9999 }
  },
  "extras": {
    "containers": {
      "lowest": "#080f18",
      "low": "#151c26",
      "base": "#19202a",
      "high": "#242a34",
      "highest": "#2e353f"
    },
    "brand": {
      "abyss": "#050b14",
      "panel": "#0a121f",
      "frame": "#1a2436",
      "neonBlue": "#0088ff",
      "steel": "#8ba0b8",
      "icyBlue": "#d5e0ff"
    },
    "animations": [
      "spin-slow", "float", "glow", "fade-up", "zoom-in",
      "fade-in", "fade-down", "fade-left", "fade-right", "zoom-out",
      "shake", "wiggle", "blink", "gradient-shift", "scan",
      "bar-wave", "spin-orbit", "move-particle", "bounce-smooth", "core-rotate"
    ],
    "effects": [
      "cut-panel", "cut-button", "cut-architectural",
      "wireframe-grid", "blueprint-scan", "hero-radial-glow",
      "cyber-scrollbar", "no-scrollbar", "brutalist-scroll",
      "observe-section", "is-visible", "particle-element"
    ]
  },
  "dark": {
    "colors": {
      "bg": "#050b14",
      "surface": "#0a121f",
      "surfaceRaised": "#1a2436",
      "border": "#2e353f",
      "text": "#dce3f0",
      "textMuted": "#8ba0b8",
      "ring": "#0088ff",
      "primary": "#0088ff",
      "primaryHover": "#33a3ff",
      "primarySubtle": "#0b2038",
      "secondary": "#a8c8ff",
      "secondaryHover": "#bdd4ff",
      "secondarySubtle": "#132741",
      "accent": "#d5e0ff",
      "accentHover": "#e8eeff",
      "accentSubtle": "#1b2740",
      "success": "#10b981",
      "successSubtle": "#0a2b22",
      "warning": "#ef4646",
      "warningSubtle": "#331414",
      "error": "#e24848",
      "errorSubtle": "#2a0e0e",
      "info": "#38bdf8",
      "infoSubtle": "#0c2537"
    },
    "shadows": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.50)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.55)",
      "lg": "0 16px 44px rgba(0, 0, 0, 0.65)",
      "glow": "0 0 20px rgba(0, 136, 255, 0.40)"
    }
  }
}
